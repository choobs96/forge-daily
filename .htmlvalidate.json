{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "no-implicit-button-type": "off",
    "no-implicit-input-type": "off",
    "valid-id": "off",
    "prefer-tbody": "off",
    "empty-heading": "off",
    "no-raw-characters": "off",
    "attr-spacing": "off",
    "void-style": "off",
    "long-title": "off",
    "wcag/h30": "off",
    "wcag/h37": "off",
    "wcag/h63": "off",
    "wcag/h67": "off",
    "wcag/h71": "off"
  }
}
